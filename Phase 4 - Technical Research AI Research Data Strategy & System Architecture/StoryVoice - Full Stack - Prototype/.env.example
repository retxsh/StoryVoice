# StoryVoice Environment Variables

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase (Auth, PostgreSQL, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Speech-to-Text Providers
# Benchmarked candidate 1: Deepgram Nova-3
DEEPGRAM_API_KEY=your-deepgram-api-key
# Benchmarked candidate 2: OpenAI Whisper API
OPENAI_API_KEY=your-openai-api-key

# AI Transformation Providers
# Candidate 1: Google Gemini (Gemini 2.5/Flash/Pro)
GEMINI_API_KEY=your-gemini-api-key
# Candidate 2: Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage Buckets
STORAGE_AUDIO_BUCKET=audio_recordings
STORAGE_EXPORTS_BUCKET=exports

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000
WORKER_LEASE_SECONDS=300
